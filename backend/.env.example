PORT=5000

# get this from your MongoDB Atlas cluster -> Connect -> Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/route-optimizer

# public demo server, swap for your own OSRM instance later if you need reliability
OSRM_BASE_URL=https://router.project-osrm.org

# where the python solver-service is running
SOLVER_URL=http://localhost:8000

# any long random string - used to sign login tokens, generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-string

# who's allowed to call this api - comma-separated if you have more than one (e.g. add your deployed frontend url later)
FRONTEND_URL=http://localhost:5173
